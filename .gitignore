# Unity - zemi_preparing3 specific
zemi_preparing3/.utmp/
zemi_preparing3/[Ll]ibrary/
zemi_preparing3/[Tt]emp/
zemi_preparing3/[Oo]bj/
zemi_preparing3/[Bb]uild/
zemi_preparing3/[Bb]uilds/
zemi_preparing3/[Ll]ogs/
zemi_preparing3/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
zemi_preparing3/*.blend1
zemi_preparing3/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
zemi_preparing3/[Mm]emoryCaptures/

# Recordings can get excessive in size
zemi_preparing3/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
zemi_preparing3/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
zemi_preparing3/.vs/

# Gradle cache directory
zemi_preparing3/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
zemi_preparing3/ExportedObj/
zemi_preparing3/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
zemi_preparing3/sysinfo.txt

# Mono auto generated files
zemi_preparing3/mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
zemi_preparing3/crashlytics-build.properties

# TestRunner generated files
zemi_preparing3/InitTestScene*.unity*

# Addressables default ignores, before user customizations
zemi_preparing3/ServerData
zemi_preparing3/[Aa]ssets/StreamingAssets/aa*
zemi_preparing3/[Aa]ssets/AddressableAssetsData/link.xml*
zemi_preparing3/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
zemi_preparing3/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
zemi_preparing3/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
zemi_preparing3/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
zemi_preparing3/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
zemi_preparing3/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
zemi_preparing3/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
